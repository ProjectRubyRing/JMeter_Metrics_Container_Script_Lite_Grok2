# コンテナに入るスクリプトは LF 固定 (CRLF だと /bin/sh が "\r" を含むコマンドとして解釈して失敗する)
*.sh        text eol=lf
Dockerfile  text eol=lf
*.java      text eol=lf
*.py        text eol=lf
*.jsonc     text eol=lf
*.md        text eol=lf
# Windows PowerShell 5.1 で実行するスクリプトは CRLF (UTF-8 BOM 付き)
*.ps1       text eol=crlf
# git apply で当てるパッチは 1 バイトも変えない
*.patch     -text
# 試験用の収集結果 (perf-metrics.sh が書いたままの LF の CSV) も変えない
test/fixtures/** -text
