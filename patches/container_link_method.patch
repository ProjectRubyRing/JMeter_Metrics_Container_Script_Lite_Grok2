+# =============================================================================
+# ③ top / ps (無いイメージでは /proc から同じ項目を算出) と JBoss のスレッド別・FD・TCP
+# ④ CPU の待ち・steal・スロットリング (cpu_sched.csv)
+# =============================================================================
+pm_role_awk='
+function role(c) {
+  if (c ~ /perf\.metrics\.collector=jboss-cli/) return "jboss-cli"
+  if (c ~ /perf\.metrics\.collector=jstat/) return "jstat"
+  if (c ~ /perf\.metrics\.collector=jcmd/) return "jcmd"
+  if (c ~ /perf\.metrics\.collector=jfr/) return "jfr-csv"
+  if (c ~ /org\.jboss\.as\.cli|jboss-cli/) return "cli-other"
+  if (c ~ /\[Standalone\]|org\.jboss\.as\.standalone/) return "jboss"
+  if (c ~ /standalone\.sh/) return "standalone.sh"
+  if (c ~ /sun\.tools\.(jstat|jcmd)|(^|\/)(jstat|jcmd)( |$)/) return "jdk-tool"
+  if (c ~ /perf-metrics/) return "perf-metrics"
+  if (c ~ /^(\/usr\/bin\/)?top( |$)/) return "top"
+  if (c ~ /^(\/usr\/bin\/)?ps( |$)/) return "ps"
+  return "other"
+}
+function mask(s,    o, k) {
+  o = ""
+  while (match(s, /[A-Za-z0-9_.-]*[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd][A-Za-z0-9_.-]*[=:][^ ,]*/)) {
+    k = substr(s, RSTART, RLENGTH); sub(/[=:].*/, "", k)
+    o = o substr(s, 1, RSTART - 1) k substr(s, RSTART + length(k), 1) "********"
+    s = substr(s, RSTART + RLENGTH)
+  }
+  return o s
+}
+function csvq(s) { if (s ~ /[",\r\n]/) { gsub(/"/, "\"\"", s); return "\"" s "\"" } return s }
+'
+
+PM_TOP_SUM_H="timestamp,epoch,load1,load5,load15,tasks_total,tasks_running,tasks_sleeping,tasks_stopped,tasks_zombie,cpu_us,cpu_sy,cpu_ni,cpu_id,cpu_wa,cpu_hi,cpu_si,cpu_st,mem_total_mib,mem_free_mib,mem_used_mib,mem_buffcache_mib,swap_total_mib,swap_free_mib,swap_used_mib,mem_avail_mib"
+PM_TOP_PROC_H="timestamp,epoch,pid,role,user,pr,ni,virt_kb,res_kb,shr_kb,state,cpu_pct,mem_pct,time,command"
+PM_TOP_TH_H="timestamp,epoch,rank,tid,thread,state,cpu_pct,time"
+PM_PS_H="timestamp,epoch,pid,ppid,role,user,stat,nlwp,rss_kb,vsz_kb,pcpu,pmem,etimes,cpu_time_s,args"
+# ps -o pid=,ppid=,user=,stat=,nlwp=,rss=,vsz=,pcpu=,pmem=,etimes=,times=,args= の 1 行 → CSV
+PM_PS_AWK='
+{ args = $0; for (k = 1; k <= 11; k++) sub(/^ *[^ ]+/, "", args); sub(/^ +/, "", args); args = mask(args)
+  print ts "," epoch "," $1 "," $2 "," role(args) "," csvq($3) "," $4 "," $5 "," $6 "," $7 "," $8 "," $9 "," $10 "," $11 "," csvq(args) }
+'
+
+# top -b の出力 (要約行とプロセス行) を CSV にする
+PM_TOP_AWK='
+function fullrole(pid, cmd,    r, c, l) {
+  r = role(cmd)
+  if (r != "other" || length(cmd) < 200) return r
+  if (pid in RC) return RC[pid]
