+            -v procf="${PM_OUT}/os_ps.csv" -v newstate="" \
+            "${pm_role_awk}${PM_PROCTOP_AWK}" "${PM_W}/procps.list" 2>> "${PM_W}/ps.err"
+        pm_sleep_tick "${PERF_PS_INTERVAL}"
+    done
+}
+
+# ---- JBoss のスレッド別 (用途ごと) CPU・状態、FD・TCP、④ CPU の待ち ----
+PM_JBOSS_TH_H="timestamp,epoch,pid,group,threads,running,sleeping,disk_wait,other_state,cpu_pct,nonvol_ctxsw_per_sec"
+PM_JBOSS_PROC_H="timestamp,epoch,pid,threads,fd_count,fd_limit,vm_rss_kb,vm_hwm_kb,rss_anon_kb,rss_file_kb,tcp_sockets,tcp_established,tcp_established_in,tcp_established_out,tcp_close_wait,tcp_listen,tcp_other,tcp_time_wait_all,est_out_ports,est_in_ports"
+PM_SCHED_H="timestamp,epoch,cpus,cpu_user_pct,cpu_nice_pct,cpu_system_pct,cpu_iowait_pct,cpu_irq_pct,cpu_softirq_pct,cpu_steal_pct,cpu_idle_pct,procs_running,procs_blocked,load1,load5,load15,ctxt_per_sec,psi_some_avg10,psi_full_avg10,psi_some_ms,cfs_periods,cfs_throttled,cfs_throttled_ms,jboss_cpu_cores,jboss_threads_running,gc_cpu_cores,jit_cpu_cores,app_cpu_cores"
+
+PM_PROC_AWK='
+function pstat(l,    a, b, n, rest) {
+  a = index(l, "("); b = 0
+  for (n = length(l); n > a; n--) if (substr(l, n, 1) == ")") { b = n; break }
+  if (a == 0 || b == 0) return 0
+  COMM = substr(l, a + 1, b - a - 1); rest = substr(l, b + 2)
+  split(rest, F, " ")
