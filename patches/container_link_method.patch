+  }
+}
+'
+
+# 1 回分の /proc の読み取り対象を「種類 パス」の行で書き出す
+pm_proc_list() {  # mode(top|ps) jboss-pid
+    [ -n "${PM_PREV:-}" ] && [ -r "${PM_PREV}" ] && echo "prev ${PM_PREV}"
+    echo "stat /proc/stat"; echo "loadavg /proc/loadavg"; echo "meminfo /proc/meminfo"; echo "passwd /etc/passwd"
+    for _pm_d in /proc/[0-9]*; do
+        [ -r "${_pm_d}/stat" ] || continue
+        echo "pstat ${_pm_d}/stat"; echo "pstatm ${_pm_d}/statm"; echo "pstatus ${_pm_d}/status"; echo "pcmd ${_pm_d}/cmdline"
+    done
+    if [ "$1" = top ] && [ -n "$2" ] && [ "${PERF_TOP_THREADS}" -gt 0 ]; then
+        for _pm_d in /proc/"$2"/task/[0-9]*; do echo "tstat ${_pm_d}/stat"; done
+    fi
+}
+
+# /proc から top 相当の 1 区間分を書く (PM_PREV = 前回の状態)
+pm_proc_top_once() {
+    PM_PREV="${PM_W}/proctop.prev"
+    pm_jboss_alive || PM_JPID="$(pm_find_jboss_pid)" || PM_JPID=""
+    pm_now
+    pm_proc_list top "${PM_JPID}" > "${PM_W}/proctop.list"
+    awk -v mode=top -v ts="${PM_TS}" -v epoch="${PM_EPOCH}" -v nowms="$(pm_ms)" -v hz="${PM_HZ}" -v pagekb="${PM_PAGEKB}" \
+        -v topn="${PERF_TOP_THREADS}" -v sumf="${PM_OUT}/os_top_summary.csv" -v procf="${PM_OUT}/os_top_process.csv" \
+        -v thf="${PM_OUT}/os_top_threads.csv" -v newstate="${PM_W}/proctop.new" \
+        "${pm_role_awk}${PM_PROCTOP_AWK}" "${PM_W}/proctop.list" 2>> "${PM_W}/top.err"
+    mv -f "${PM_W}/proctop.new" "${PM_PREV}" 2>/dev/null
+}
+
+pm_hz_page() {
+    PM_HZ="$(getconf CLK_TCK 2>/dev/null)"; pm_is_uint "${PM_HZ}" || PM_HZ=100
+    PM_PAGEKB=$(( $(getconf PAGESIZE 2>/dev/null || echo 4096) / 1024 ))
+    [ "${PM_PAGEKB}" -gt 0 ] || PM_PAGEKB=4
+}
+
+pm_top_threads_loop() {
+    PM_NAME=top-threads
+    pm_wait_jboss || return 0
+    while :; do
+        pm_jboss_alive || PM_JPID="$(pm_find_jboss_pid)" || { sleep 5; continue; }
+        pm_log INFO "③ top -H (JBoss pid=${PM_JPID} のスレッド別 CPU 上位 ${PERF_TOP_THREADS} 件) を開始します"
+        # shellcheck disable=SC2086
+        ( LC_ALL=C TERM=dumb exec top -b -H -p "${PM_JPID}" -d "${PERF_TOP_INTERVAL}" ${PM_TOP_W} ) 2>> "${PM_W}/top.err" \
+            | awk -v top="${PERF_TOP_THREADS}" -v outf="${PM_OUT}/os_top_threads.csv" "${PM_TOPTH_AWK}"
+        sleep 5
+    done
+}
+
+pm_run_top() {
+    PM_NAME=top
+    trap 'exit 0' TERM INT
+    pm_csv_init "${PM_OUT}/os_top_summary.csv" "${PM_TOP_SUM_H}"
+    pm_csv_init "${PM_OUT}/os_top_process.csv" "${PM_TOP_PROC_H}"
+    [ "${PERF_TOP_THREADS}" -gt 0 ] && pm_csv_init "${PM_OUT}/os_top_threads.csv" "${PM_TOP_TH_H}"
+    if ! command -v top >/dev/null 2>&1; then
+        pm_hz_page
+        pm_meta os top_source "/proc (top がありません)"
+        pm_log INFO "③ top がないため /proc から top 相当の値を ${PERF_TOP_INTERVAL} 秒間隔で算出します"
+        while :; do
+            pm_proc_top_once
+            pm_sleep_tick "${PERF_TOP_INTERVAL}"
+        done
+    fi
+    PM_TOP_W=""
+    if LC_ALL=C top -b -n 1 -w 512 > /dev/null 2>&1; then PM_TOP_W="-w 512"; fi
+    pm_meta os top_source "top ($(top -v 2>&1 | head -n 1 | sed 's/^ *//'))"
+    _pm_raw=""
+    [ "${PERF_TOP_RAW}" = true ] && _pm_raw="${PM_OUT}/os_top.log"
+    if [ "${PERF_TOP_THREADS}" -gt 0 ]; then
+        ( pm_top_threads_loop ) &
+    fi
+    pm_log INFO "③ top: ${PERF_TOP_INTERVAL} 秒間隔"
+    while :; do
+        # shellcheck disable=SC2086
+        ( LC_ALL=C TERM=dumb exec top -b -c -d "${PERF_TOP_INTERVAL}" ${PM_TOP_W} ) 2>> "${PM_W}/top.err" \
+            | awk -v rawf="${_pm_raw}" -v sumf="${PM_OUT}/os_top_summary.csv" -v procf="${PM_OUT}/os_top_process.csv" "${pm_role_awk}${PM_TOP_AWK}"
+        pm_log WARN "③ top が終了しました。5 秒後に再開します (詳細: ${PM_W}/top.err)"
+        sleep 5
+    done
+}
+
+pm_run_ps() {
+    PM_NAME="ps"
+    trap 'exit 0' TERM INT
+    pm_csv_init "${PM_OUT}/os_ps.csv" "${PM_PS_H}"
+    if command -v ps >/dev/null 2>&1; then
+        pm_meta os ps_source "ps"
+        pm_log INFO "③ ps: ${PERF_PS_INTERVAL} 秒間隔"
+        while :; do
+            pm_now
+            LC_ALL=C ps -e -ww -o pid=,ppid=,user=,stat=,nlwp=,rss=,vsz=,pcpu=,pmem=,etimes=,times=,args= 2>> "${PM_W}/ps.err" \
+                | awk -v ts="${PM_TS}" -v epoch="${PM_EPOCH}" "${pm_role_awk}${PM_PS_AWK}" >> "${PM_OUT}/os_ps.csv"
