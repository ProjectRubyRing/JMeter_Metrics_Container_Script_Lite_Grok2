+  # JVM (jboss-cli が応答しなかった回も、OS スレッド数だけは書く)
+  print pre "," cli_ms "," ok "," jv("srv.state", "_value") "," jv("srv.suspend", "_value") "," jv("rc", "_value") "," pid \
+    "," jv("thr.count", "_value") "," jv("thr.peak", "_value") "," jv("thr.daemon", "_value") "," jv("thr.started", "_value") "," osthr \
+    "," jv("cls", "loaded-class-count") "," jv("cls", "total-loaded-class-count") "," jv("cls", "unloaded-class-count") \
+    "," jv("mem", "heap-memory-usage.used") "," jv("mem", "heap-memory-usage.committed") "," jv("mem", "heap-memory-usage.max") \
+    "," jv("mem", "non-heap-memory-usage.used") "," jv("mem", "non-heap-memory-usage.committed") \
+    "," g("buf", "direct", "count") "," g("buf", "direct", "memory-used") "," g("buf", "direct", "total-capacity") \
+    "," g("buf", "mapped", "count") "," g("buf", "mapped", "memory-used") \
