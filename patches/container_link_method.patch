+pm_run_proc() {
+    PM_NAME=proc
+    trap 'exit 0' TERM INT
+    pm_hz_page
+    pm_csv_init "${PM_OUT}/os_jboss_threads.csv" "${PM_JBOSS_TH_H}"
+    pm_csv_init "${PM_OUT}/os_jboss_proc.csv" "${PM_JBOSS_PROC_H}"
+    pm_csv_init "${PM_OUT}/cpu_sched.csv" "${PM_SCHED_H}"
+    _pm_cpus="$(getconf _NPROCESSORS_ONLN 2>/dev/null)"
+    # cgroup の CPU 統計 (スロットリング) と PSI (CPU の待ち) の場所
+    _pm_cst=""; _pm_psi=""
+    if [ -f /sys/fs/cgroup/cgroup.controllers ]; then
+        [ -r /sys/fs/cgroup/cpu.stat ] && _pm_cst=/sys/fs/cgroup/cpu.stat
+        [ -r /sys/fs/cgroup/cpu.pressure ] && _pm_psi=/sys/fs/cgroup/cpu.pressure
+    else
+        for _pm_g in /sys/fs/cgroup/cpu /sys/fs/cgroup/cpu,cpuacct /sys/fs/cgroup/cpuacct,cpu; do
+            [ -r "${_pm_g}/cpu.stat" ] && { _pm_cst="${_pm_g}/cpu.stat"; break; }
+        done
+    fi
+    [ -z "${_pm_psi}" ] && [ -r /proc/pressure/cpu ] && _pm_psi=/proc/pressure/cpu
+    pm_meta os proc_sources "cpu.stat=${_pm_cst:-なし} pressure=${_pm_psi:-なし}"
+    pm_log INFO "③④ /proc: ${PERF_PROC_INTERVAL} 秒間隔 (JBoss のスレッド別 CPU・FD・TCP、CPU の待ち)"
+    PM_JPID=""
+    while :; do
+        pm_jboss_alive || PM_JPID="$(pm_find_jboss_pid)" || PM_JPID=""
+        pm_now
+        _pm_nowms="$(pm_ms)"
+        {
+            [ -r "${PM_W}/proc.prev" ] && echo "prev ${PM_W}/proc.prev"
+            echo "stat /proc/stat"; echo "loadavg /proc/loadavg"
+            [ -n "${_pm_psi}" ] && echo "psi ${_pm_psi}"
+            [ -n "${_pm_cst}" ] && echo "cpustat ${_pm_cst}"
+            if [ -n "${PM_JPID}" ]; then
+                echo "pstat /proc/${PM_JPID}/stat"; echo "pstatus /proc/${PM_JPID}/status"; echo "limits /proc/${PM_JPID}/limits"
+                for _pm_t in /proc/"${PM_JPID}"/task/[0-9]*; do echo "tstat ${_pm_t}/stat"; echo "tstatus ${_pm_t}/status"; done
+                ls -l "/proc/${PM_JPID}/fd" > "${PM_W}/proc.fd" 2>/dev/null
+                echo "fd ${PM_W}/proc.fd"
+                echo "tcp /proc/net/tcp"; echo "tcp /proc/net/tcp6"
+            fi
+        } > "${PM_W}/proc.list"
+        awk -v ts="${PM_TS}" -v epoch="${PM_EPOCH}" -v nowms="${_pm_nowms}" -v hz="${PM_HZ}" -v cpus="${_pm_cpus}" -v jpid="${PM_JPID}" \
+            -v thf="${PM_OUT}/os_jboss_threads.csv" -v procf="${PM_OUT}/os_jboss_proc.csv" -v schedf="${PM_OUT}/cpu_sched.csv" \
+            -v newstate="${PM_W}/proc.new" "${PM_PROC_AWK}" "${PM_W}/proc.list" 2>> "${PM_W}/proc.err"
+        mv -f "${PM_W}/proc.new" "${PM_W}/proc.prev" 2>/dev/null
+        pm_sleep_tick "${PERF_PROC_INTERVAL}"
+    done
+}
