+      }
+    }
+    if (topn > 0 && el > 0) {
+      n = 0
+      for (i = 1; i <= NT; i++) { k = TIDS[i]; if (!(k in PTT)) continue; c = (TTK[k] - PTT[k]) * 100.0 / (el * hz); if (c < 0) c = 0; n++; SK[n] = k; SC[n] = c }
+      for (a2 = 1; a2 <= n && a2 <= topn; a2++) { m = a2; for (b2 = a2 + 1; b2 <= n; b2++) if (SC[b2] > SC[m]) m = b2; t = SK[a2]; SK[a2] = SK[m]; SK[m] = t; t = SC[a2]; SC[a2] = SC[m]; SC[m] = t
