+
+# top -b -H -p <JBoss> の出力 (スレッド行) を CSV にする (上位 top 件)
+PM_TOPTH_AWK='
+function stamp(    cmd, l) { cmd = "date \"+%Y-%m-%d %H:%M:%S|%s\""; cmd | getline l; close(cmd); split(l, T, "|"); TS = T[1]; EP = T[2] }
