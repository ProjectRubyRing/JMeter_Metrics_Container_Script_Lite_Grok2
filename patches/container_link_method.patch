+    }
+    for (i = 1; i <= NO["ses"]; i++) { ent = ORD["ses", i]; print pre "," csvq(ent) cols("ses", ent, SESC) >> (dir "/cli_session.csv") }
+    for (i = 1; i <= NO["iow"]; i++) {
