+    for (i = 1; i <= NP; i++) {
+      pid = PIDS[i]; cmd = PCMD[pid]; sub(/ +$/, "", cmd); if (cmd == "") cmd = "[" PCOMM[pid] "]"; cmd = mask(cmd)
