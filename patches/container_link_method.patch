+'
+
+# ---- /proc からの算出 (top / ps が無いイメージ) ----
+# 入力は「種類 パス」の行。ファイルは getline で読む (途中で消えたスレッドのファイルは無視)。
+# 前回の値 (CPU 時間など) を状態ファイルに残し、差分から区間の %CPU を求める (top と同じ考え方)。
+PM_PROCTOP_AWK='
+function pstat(l,    a, b, n, rest) {
+  a = index(l, "("); b = 0
+  for (n = length(l); n > a; n--) if (substr(l, n, 1) == ")") { b = n; break }
+  if (a == 0 || b == 0) return 0
+  COMM = substr(l, a + 1, b - a - 1); rest = substr(l, b + 2)
+  split(rest, F, " ")
+  return 1
+}
+function tm(t,    s, m) { s = t / hz; m = int(s / 60); return sprintf("%d:%05.2f", m, s - m * 60) }
+function line(tag, p, l,    k, pid) {
+  if (tag == "prev") { split(l, a, " "); if (a[1] == "ms") PMS = a[2]; else if (a[1] == "cpu") { for (k = 2; k <= 9; k++) PC[k] = a[k] } else if (a[1] == "p") PT[a[2]] = a[3]; else if (a[1] == "t") PTT[a[2]] = a[3]; return }
+  if (tag == "stat" && l ~ /^cpu /) { split(l, a, " "); for (k = 2; k <= 9; k++) NCPU[k] = a[k]; return }
+  if (tag == "loadavg") { split(l, a, " "); L1 = a[1]; L5 = a[2]; L15 = a[3]; return }
+  if (tag == "meminfo") { split(l, a, /[: ]+/); MI[a[1]] = a[2]; return }
+  if (tag == "passwd") { split(l, a, ":"); UN[a[3]] = a[1]; return }
+  if (tag == "pstat") { if (pstat(l)) { pid = p; sub(/^\/proc\//, "", pid); sub(/\/.*$/, "", pid); PS[pid] = F[1]; PPID2[pid] = F[2]; PTK[pid] = F[12] + F[13]; PPR[pid] = F[16]; PNI[pid] = F[17]; PNL[pid] = F[18]; PST[pid] = F[20]; PVS[pid] = F[21]; PCOMM[pid] = COMM; PIDS[++NP] = pid } return }
+  if (tag == "pstatm") { pid = p; sub(/^\/proc\//, "", pid); sub(/\/.*$/, "", pid); split(l, a, " "); PRS[pid] = a[2]; PSH[pid] = a[3]; return }
+  if (tag == "pstatus") { if (l ~ /^Uid:/) { pid = p; sub(/^\/proc\//, "", pid); sub(/\/.*$/, "", pid); split(l, a, /[ \t]+/); PU[pid] = a[3] } return }
+  if (tag == "pcmd") { pid = p; sub(/^\/proc\//, "", pid); sub(/\/.*$/, "", pid); gsub(/\000/, " ", l); PCMD[pid] = PCMD[pid] l; return }
+  if (tag == "tstat") { if (pstat(l)) { k = p; sub(/^.*\/task\//, "", k); sub(/\/.*$/, "", k); TSTA[k] = F[1]; TTK[k] = F[12] + F[13]; TCOMM[k] = COMM; TIDS[++NT] = k } return }
+}
+function rd(p, tag,    l, n) { n = 0; while ((getline l < p) > 0) { n++; line(tag, p, l) } close(p); return n }
+{ tag = $1; p = substr($0, length($1) + 2); rd(p, tag) }
+END {
+  el = (PMS != "") ? (nowms - PMS) / 1000.0 : 0
+  memt = MI["MemTotal"] + 0
+  if (mode == "top") {
+    for (i = 1; i <= NP; i++) { s = PS[PIDS[i]]; ta++; if (s == "R") tr++; else if (s == "T" || s == "t") tt++; else if (s == "Z") tz++; else tsl++ }
+    tot = 0; for (k = 2; k <= 9; k++) { d[k] = NCPU[k] - PC[k]; tot += d[k] }
