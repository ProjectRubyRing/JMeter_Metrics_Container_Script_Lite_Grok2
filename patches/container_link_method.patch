+    if (a[1] == "ms") PMS = a[2]; else if (a[1] == "cpu") { for (k = 2; k <= 9; k++) PC[k] = a[k] } else if (a[1] == "ctxt") PCT = a[2]
+    else if (a[1] == "psi") PPSI = a[2]; else if (a[1] == "thr") { PNP = a[2]; PNT = a[3]; PTU = a[4] } else if (a[1] == "pt") PPT = a[2]
+    else if (a[1] == "t") { PTT[a[2]] = a[3]; PTV[a[2]] = a[4] }
+    return }
+  if (tag == "stat") { split(l, a, " ")
+    if (a[1] == "cpu") { for (k = 2; k <= 9; k++) NCPU[k] = a[k] } else if (a[1] == "ctxt") NCT = a[2]; else if (a[1] == "procs_running") PRUN = a[2]; else if (a[1] == "procs_blocked") PBLK = a[2]
+    return }
+  if (tag == "loadavg") { split(l, a, " "); L1 = a[1]; L5 = a[2]; L15 = a[3]; return }
+  if (tag == "psi") {
+    if (l ~ /^some /) { if (match(l, /avg10=[0-9.]+/)) PSIS = substr(l, RSTART + 6, RLENGTH - 6); if (match(l, /total=[0-9]+/)) PSIT = substr(l, RSTART + 6, RLENGTH - 6) }
+    if (l ~ /^full /) { if (match(l, /avg10=[0-9.]+/)) PSIF = substr(l, RSTART + 6, RLENGTH - 6) }
+    return }
+  if (tag == "cpustat") { split(l, a, " "); if (a[1] == "nr_periods") NNP = a[2]; else if (a[1] == "nr_throttled") NNT = a[2]; else if (a[1] == "throttled_usec") NTU = a[2]; else if (a[1] == "throttled_time") NTU = int(a[2] / 1000); return }
+  if (tag == "pstat") { if (pstat(l)) PTK = F[12] + F[13]; return }
+  if (tag == "pstatus") { split(l, a, /[: \t]+/)
+    if (a[1] == "Threads") PTHR = a[2]; else if (a[1] == "VmRSS") RSS = a[2]; else if (a[1] == "VmHWM") HWM = a[2]; else if (a[1] == "RssAnon") RANON = a[2]; else if (a[1] == "RssFile") RFILE = a[2]
+    return }
+  if (tag == "limits") { if (l ~ /^Max open files/) { split(l, a, /  +/); FDLIM = a[2] } return }
+  if (tag == "tstat") { if (pstat(l)) { tid = p; sub(/^.*\/task\//, "", tid); sub(/\/.*$/, "", tid); TK[tid] = F[12] + F[13]; TS0[tid] = F[1]; TG[tid] = grp(COMM); TIDS[++NTH] = tid } return }
+  if (tag == "tstatus") { if (l ~ /^nonvoluntary_ctxt_switches:/) { tid = p; sub(/^.*\/task\//, "", tid); sub(/\/.*$/, "", tid); split(l, a, /[: \t]+/); TV[tid] = a[2] } return }
+  if (tag == "fd") { if (l ~ / -> /) NFD++; if (match(l, /socket:\[[0-9]+\]/)) SOCK[substr(l, RSTART + 8, RLENGTH - 9)] = 1; return }
+  if (tag == "tcp") {
+    split(l, a, " "); if (a[1] !~ /^[0-9]+:$/) return
+    st = a[4]
+    if (st == "06") TWALL++
+    if (!(a[10] in SOCK)) return
+    NSOCK++
+    split(a[2], lo, ":"); split(a[3], re, ":"); lp = hex(lo[2]); rp = hex(re[2])
+    if (st == "0A") { LISTEN++; LP[lp] = 1 }
+    else if (st == "01") { NE++; EL[NE] = lp; ER[NE] = rp }
+    else if (st == "08") CLOSEW++
+    else OTHER++
+    return }
+}
+function rd(p, tag,    l) { while ((getline l < p) > 0) line(tag, p, l); close(p) }
+function topports(arr,    n, s, k, i, j, m, t, KK, VV) {
+  n = 0; for (k in arr) { n++; KK[n] = k; VV[n] = arr[k] }
+  s = ""
+  for (i = 1; i <= n && i <= 5; i++) { m = i; for (j = i + 1; j <= n; j++) if (VV[j] > VV[m]) m = j; t = KK[i]; KK[i] = KK[m]; KK[m] = t; t = VV[i]; VV[i] = VV[m]; VV[m] = t; if (s != "") s = s " "; s = s KK[i] ":" VV[i] }
+  return s
+}
+{ tag = $1; p = substr($0, length($1) + 2); rd(p, tag) }
+END {
+  el = (PMS != "") ? (nowms - PMS) / 1000.0 : 0
+  # ---- JBoss のスレッドを用途別に ----
+  if (jpid != "") {
+    for (i = 1; i <= NTH; i++) {
+      t = TIDS[i]; g = TG[t]
+      for (k = 0; k < 2; k++) { gg = (k == 0) ? "all" : g
+        if (!(gg in GN)) GO[++NG] = gg
+        GN[gg]++; s = TS0[t]
+        if (s == "R") GR[gg]++; else if (s == "S" || s == "I") GS[gg]++; else if (s == "D") GD[gg]++; else GX[gg]++
+        if (el > 0 && (t in PTT)) { dt = TK[t] - PTT[t]; if (dt > 0) GT[gg] += dt; dv = TV[t] - PTV[t]; if (dv > 0) GV[gg] += dv }
+      }
+    }
+    for (i = 1; i <= NG; i++) { gg = GO[i]
+      printf "%s,%s,%s,%s,%d,%d,%d,%d,%d,%s,%s\n", ts, epoch, jpid, gg, GN[gg], GR[gg], GS[gg], GD[gg], GX[gg], \
+        (el > 0 ? sprintf("%.1f", GT[gg] * 100.0 / (el * hz)) : ""), (el > 0 ? sprintf("%.1f", GV[gg] / el) : "") >> thf }
+    # ---- FD・TCP (JBoss が持っているソケットだけを数える。TIME_WAIT は持ち主が無いのでタスク全体) ----
+    for (i = 1; i <= NE; i++) { if (EL[i] in LP) { NIN++; IN[EL[i]]++ } else { NOUT++; OUTP[ER[i]]++ } }
+    printf "%s,%s,%s,%s,%d,%s,%s,%s,%s,%s,%d,%d,%d,%d,%d,%d,%d,%d,%s,%s\n", ts, epoch, jpid, PTHR, NFD, FDLIM, RSS, HWM, RANON, RFILE, NSOCK, NE, NIN, NOUT, CLOSEW, LISTEN, OTHER, TWALL, \
+      topports(OUTP), topports(IN) >> procf
+  }
+  # ---- ④ CPU の待ち・steal・スロットリング ----
+  tot = 0; for (k = 2; k <= 9; k++) { d[k] = NCPU[k] - PC[k]; tot += d[k] }
+  if (el > 0 && tot > 0) {
+    app = GT["http-task"] + GT["http-io"] + GT["ee-ejb"] + GT["other"]
+    printf "%s,%s,%s,%.1f,%.1f,%.1f,%.1f,%.1f,%.1f,%.1f,%.1f,%s,%s,%s,%s,%s,%.0f,%s,%s,%s,%s,%s,%s,%s,%d,%s,%s,%s\n", ts, epoch, cpus, \
+      d[2] * 100 / tot, d[3] * 100 / tot, d[4] * 100 / tot, d[6] * 100 / tot, d[7] * 100 / tot, d[8] * 100 / tot, d[9] * 100 / tot, d[5] * 100 / tot, \
+      PRUN, PBLK, L1, L5, L15, (NCT - PCT) / el, PSIS, PSIF, (PSIT != "" && PPSI != "" ? sprintf("%.1f", (PSIT - PPSI) / 1000.0) : ""), \
+      (NNP != "" && PNP != "" ? NNP - PNP : ""), (NNT != "" && PNT != "" ? NNT - PNT : ""), (NTU != "" && PTU != "" ? sprintf("%.1f", (NTU - PTU) / 1000.0) : ""), \
+      (jpid != "" && PPT != "" ? sprintf("%.3f", (PTK - PPT) / hz / el) : ""), GR["all"], \
+      (jpid != "" ? sprintf("%.3f", GT["gc"] / hz / el) : ""), (jpid != "" ? sprintf("%.3f", GT["jit"] / hz / el) : ""), (jpid != "" ? sprintf("%.3f", app / hz / el) : "") >> schedf
+  }
+  printf "ms %s\n", nowms > newstate
+  printf "cpu" > newstate; for (k = 2; k <= 9; k++) printf " %s", NCPU[k] > newstate; printf "\n" > newstate
+  printf "ctxt %s\n", NCT > newstate
+  if (PSIT != "") printf "psi %s\n", PSIT > newstate
+  if (NNP != "") printf "thr %s %s %s\n", NNP, NNT, NTU > newstate
+  if (jpid != "") { printf "pt %s\n", PTK > newstate; for (i = 1; i <= NTH; i++) printf "t %s %s %s\n", TIDS[i], TK[TIDS[i]], TV[TIDS[i]] + 0 > newstate }
+  close(newstate)
+}
+'
