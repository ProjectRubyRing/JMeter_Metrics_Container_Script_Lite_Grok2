+      printf "%s,%s,%s,%s,%s,%d,%d,%d,%d,%d,%.1f,%.1f,%.1f,%.1f,%.1f,%.1f,%.1f,%.1f,%.1f,%.1f,%.1f,%.1f,%.1f,%.1f,%.1f,%.1f\n", ts, epoch, L1, L5, L15, ta, tr, tsl, tt, tz, \
+        d[2] * 100 / tot, d[4] * 100 / tot, d[3] * 100 / tot, d[5] * 100 / tot, d[6] * 100 / tot, d[7] * 100 / tot, d[8] * 100 / tot, d[9] * 100 / tot, \
+        memt / 1024, MI["MemFree"] / 1024, (memt - MI["MemFree"] - MI["Buffers"] - MI["Cached"] - MI["SReclaimable"]) / 1024, (MI["Buffers"] + MI["Cached"] + MI["SReclaimable"]) / 1024, \
